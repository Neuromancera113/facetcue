include LICENSE README.md README.zh-CN.md CONTRIBUTING.md SECURITY.md AGENTS.md
include pyproject.toml ruff.toml requirements-dev.txt
include .gitignore .gitattributes
recursive-include blender_agent_marks *.py *.toml
recursive-include agent_mcp *.py
recursive-include scripts *.py
recursive-include tests *.py
recursive-include docs *.md *.srt
recursive-include contracts *.json
recursive-include examples *.toml
recursive-include .github *.yml *.md
prune artifacts
prune dist
prune build
prune .venv
prune .ruff_cache
prune .pytest_cache
global-exclude .DS_Store Thumbs.db
global-exclude *.pyc
global-exclude *.log *.tmp *.blend *.blend1 *.blend2
